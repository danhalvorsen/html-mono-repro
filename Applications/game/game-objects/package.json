{
  "name": "@monorepo/game-objects",
  "version": "1.0.0",
  "description": "Example module scaffold.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:typecheck": "vitest run --typecheck",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "keywords": [
    "module",
    "typescript",
    "example"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "lit": "^3.2.2",
    "@monorepo/core-math": "workspace:*",
    "@monorepo/core-design-patterns": "workspace:*",
    "@monorepo/game-design-patterns": "workspace:*",
    "@monorepo/game-design-svg": "workspace:*",
    "@monorepo/game-feature-cave": "workspace:*",
    "@monorepo/game-motion": "workspace:*",
    "@monorepo/game-assets-shapes": "workspace:*",
    "@monorepo/game-motion-animation": "workspace:*"  
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "jsdom": "^26.1.0"
  }
}
