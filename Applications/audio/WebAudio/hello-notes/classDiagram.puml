@startuml
title Music Notes – Web Components Architecture

package "music.notes.sheet.abstract" {
    interface INote
    interface IStaff
    interface IScore
    interface INoteBuilder
    interface IScoreFactory
}

package "music.notes.sheet.DOM" {
    class AbcParser
    class AbcToDomainMapper
    class DomNoteBuilder
    class DomScoreFactory

    AbcParser --> AbcToDomainMapper : parsed ABC
    AbcToDomainMapper --> INote
    AbcToDomainMapper --> IScore
    DomNoteBuilder ..|> INoteBuilder
    DomScoreFactory ..|> IScoreFactory
}

package "music.notes.sheet.threejs" {
    class NoteLineBuilder
    class ThreeScoreRenderer

    IScore --> ThreeScoreRenderer
    ThreeScoreRenderer --> NoteLineBuilder
}

package "Web Components" {
    component note_sheets <<WC>>
    component canvas_note_editor <<WC>>
    component three_demo_app <<WC>>
}

AbcToDomainMapper --> canvas_note_editor : emits IScore
canvas_note_editor --> note_sheets : slot composition
three_demo_app --> canvas_note_editor : owns

ThreeScoreRenderer --> note_sheets : registerObject
note_sheets --> NoteLineBuilder : uses builder

@enduml
