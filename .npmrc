# Enable creation of .bin symlinks so pnpm can create executables on Windows
bin-links=true

# Keep hoisted layout if you prefer it
node-linker=hoisted
shamefully-hoist=true

# Ensure pnpm package is hoisted to repo node_modules so "pnpm -r" from packages resolves
public-hoist-pattern[]=*pnpm*

# Use a shared store and workspace lockfile at the repo root
shared-workspace-lockfile=true
store-dir=.pnpm-store
