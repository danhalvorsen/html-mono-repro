{
    "activationEvents":  [

                         ],
    "dependencies":  {
                         "express":  "^5.2.1",
                         "inversify":  "^6.x",
                         "reflect-metadata":  "^0.2.2",
                         "tsyringe":  "^4.10.0",
                         "zod":  "^4.3.6",
                         "lit":  "^3.3.2",
                         "@monorepo/music-core-midi":  "workspace:*",
                         "@monorepo/music-core-synthesizer-oscillators-contracts":  "workspace:*",
                         "@monorepo/music-core-synthesizer-oscillators-web-audio":  "workspace:*"
                     },
    "devDependencies":  {
                            "@eslint/js":  "^9.39.4",
                            "@types/express":  "^5.0.6",
                            "@types/node":  "^20.19.39",
                            "@typescript-eslint/eslint-plugin":  "8",
                            "@typescript-eslint/parser":  "8",
                            "@vitest/ui":  "3.2.4",
                            "eslint":  "9.39.4",
                            "eslint-config-prettier":  "10.1.8",
                            "eslint-import-resolver-typescript":  "4.4.4",
                            "eslint-plugin-import":  "2.32.0",
                            "eslint-plugin-unused-imports":  "4",
                            "pnpm":  "^10.24.0",
                            "rimraf":  "^6.0.1",
                            "tsx":  "^4.21.0",
                            "typescript":  "~6.0.2",
                            "vite":  "^8.0.10",
                            "vitest":  "^3.2.4"
                        },
    "scripts":  {
                    "build:packages":  "pnpm -r --filter \"./packages/**\" run build",
                    "build:apps":  "pnpm -r --filter \"./Applications/**\" run build",
                    "build":  "tsc \u0026\u0026 vite build",
                    "lint":  "pnpm run lint:packages \u0026\u0026 pnpm run lint:apps",
                    "lint:fix":  "pnpm run lint:fix:packages \u0026\u0026 pnpm run lint:fix:apps",
                    "lint:packages":  "pnpm -r --filter \"./packages/**\" --workspace-concurrency=4 --if-present run lint",
                    "lint:apps":  "pnpm -r --filter \"./Applications/**\" --workspace-concurrency=4 --if-present run lint",
                    "lint:fix:packages":  "pnpm -r --filter \"./packages/**\" --workspace-concurrency=4 --if-present run lint:fix",
                    "lint:fix:apps":  "pnpm -r --filter \"./Applications/**\" --workspace-concurrency=4 --if-present run lint:fix",
                    "test":  "pnpm --workspace-root vitest",
                    "fix:tsc-scripts":  "node ./scripts/fix-tsc-in-scripts.js",
                    "fix:workspace-deps":  "node ./scripts/fix-workspace-deps.js",
                    "fix:all":  "node ./scripts/fix-workspace-deps.js \u0026\u0026 node ./scripts/fix-tsc-in-scripts.js",
                    "scan:packages":  "node ./scripts/scan-package-names.js",
                    "agent:run":  "powershell -ExecutionPolicy Bypass -File ./scripts/agent-run.ps1",
                    "workspace:build":  "pnpm -r run build",
                    "bootstrap":  "pnpm install --recursive",
                    "ci-install":  "pnpm install --shamefully-hoist --reporter=silent",
                    "prebuild":  "node -e \"const fs=require(\u0027fs\u0027); if(!fs.existsSync(\u0027./node_modules/pnpm\u0027)){console.error(\u0027ERROR: pnpm is not installed in this repo. Run `pnpm install` at the repo root (or `pnpm bootstrap`).\u0027); process.exit(1)}\"",
                    "postinstall":  "node ./scripts/ensure-pnpm.js || true",
                    "prebuild:win":  "powershell -NoProfile -ExecutionPolicy Bypass -Command \"if(-not (Test-Path \u0027./node_modules/pnpm\u0027)) { Write-Error \u0027ERROR: pnpm binary not found in workspace node_modules. Run `pnpm install` at the repo root.\u0027; exit 1 }\"",
                    "dev":  "vite",
                    "preview":  "vite preview"
                },
    "packageManager":  "pnpm@10.33.0",
    "description":  "Lit 3 sandbox for composing synthesizer modules without the centralized synth engine."
}
