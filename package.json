{
    "activationEvents": [],
    "dependencies": {
        "inversify": "^6.x",
        "reflect-metadata": "^0.2.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@types/node": "^20.19.25",
        "@typescript-eslint/eslint-plugin": "8",
        "@typescript-eslint/parser": "8",
        "@vitest/coverage-v8": "3.2.4",
        "@vitest/ui": "3.2.4",
        "eslint": "9.39.4",
        "eslint-config-prettier": "10.1.8",
        "eslint-import-resolver-typescript": "4.4.4",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-unused-imports": "4",
        "pnpm": "^10.24.0",
        "rimraf": "^6.0.1",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vite": "^5.0.0",
        "vitest": "3.2.4"
    },
    "scripts": {
        "build:packages": "pnpm -r --filter \"./packages/**\" run build",
        "build:apps": "pnpm -r --filter \"./Applications/**\" run build",
        "build": "pnpm -r run build",
        "lint": "pnpm run lint:packages && pnpm run lint:apps",
        "lint:fix": "pnpm run lint:fix:packages && pnpm run lint:fix:apps",
        "lint:packages": "pnpm -r --filter \"./packages/**\" --workspace-concurrency=4 --if-present run lint",
        "lint:apps": "pnpm -r --filter \"./Applications/**\" --workspace-concurrency=4 --if-present run lint",
        "lint:fix:packages": "pnpm -r --filter \"./packages/**\" --workspace-concurrency=4 --if-present run lint:fix",
        "lint:fix:apps": "pnpm -r --filter \"./Applications/**\" --workspace-concurrency=4 --if-present run lint:fix",
        "test": "pnpm --workspace-root vitest",
        "fix:tsc-scripts": "node ./scripts/fix-tsc-in-scripts.js",
        "fix:workspace-deps": "node ./scripts/fix-workspace-deps.js",
        "fix:all": "node ./scripts/fix-workspace-deps.js && node ./scripts/fix-tsc-in-scripts.js",
        "scan:packages": "node ./scripts/scan-package-names.js",
        "agent:run": "powershell -ExecutionPolicy Bypass -File ./scripts/agent-run.ps1",
        "workspace:build": "pnpm -r run build",
        "bootstrap": "pnpm install --recursive",
        "ci-install": "pnpm install --shamefully-hoist --reporter=silent",
        "prebuild": "node -e \"const fs=require('fs'); if(!fs.existsSync('./node_modules/pnpm')){console.error('ERROR: pnpm is not installed in this repo. Run `pnpm install` at the repo root (or `pnpm bootstrap`).'); process.exit(1)}\"",
        "postinstall": "node ./scripts/ensure-pnpm.js || true",
        "prebuild:win": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"if(-not (Test-Path './node_modules/pnpm')) { Write-Error 'ERROR: pnpm binary not found in workspace node_modules. Run `pnpm install` at the repo root.'; exit 1 }\""
    },
    "packageManager": "pnpm@10.33.0"
}
