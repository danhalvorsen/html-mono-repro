{
  "compilerOptions": {
    "composite": true,

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],

    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "rootDir": "./src",
    "outDir": "./dist",

    "declaration": true,

    "esModuleInterop": true,
    "resolveJsonModule": true,

    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
   "include": [
    "src"
  ],
  "exclude": ["dist", "node_modules"]
}
