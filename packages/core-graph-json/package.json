{
  "name": "@monorepo/core-graph-json",
  "version": "1.0.0",
  "description": "JSON serialization and deserialization for @monorepo/core-graph.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:typecheck": "vitest run --typecheck"
  },
  "keywords": [
    "graph",
    "json",
    "serialization",
    "deserialization"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@monorepo/core-graph": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"}
}