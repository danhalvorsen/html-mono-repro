    "@monorepo/core-pdf-reader": "workspace:*",
    "@monorepo/core-pdf-writer": "workspace:*",
    "@monorepo/core-pdf-presenter": "workspace:*",
    "@monorepo/core-lit-monaco-code-editor-project-schema": "workspace:*",
    "typescript": "^5.8.3"
  }
