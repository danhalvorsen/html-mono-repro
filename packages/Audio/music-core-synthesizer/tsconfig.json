{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["DOM", "ES2022"],

    "rootDir": "./src",
    "outDir": "./dist",

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "strict": true,
    "esModuleInterop": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "types": [],
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "../music-core-synthesizer-schema/src/SemanticValidationError.ts", "../music-core-synthesizer-schema/src/ISemanticValidator.ts"],
  "exclude": ["dist", "node_modules", "tests"]
}
