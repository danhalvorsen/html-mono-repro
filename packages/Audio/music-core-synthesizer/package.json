{
  "name": "@monorepo/music-core-synthesizer",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:schema-types": "tsx ./script/generate-schema-types.ts",
    "generate:state-types": "openapi-typescript ./schemas/state.yaml -o ./src/generated/state.d.ts"
  },
  "dependencies": {
    "@monorepo/core-specifications": "workspace:*",
    "@monorepo/core-specifications-rules": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.20.6",
    "yaml": "^2.8.3"
  }
}
