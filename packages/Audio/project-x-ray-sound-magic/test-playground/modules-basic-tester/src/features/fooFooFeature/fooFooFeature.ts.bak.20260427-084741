import { html, type TemplateResult } from "lit";

import type { IViewFeature } from "../../infrastructure/IViewFeature.js";

export class FooFooFeature implements IViewFeature {
  public readonly id = "foo-foo";

  public renderNavigationTemplate(): TemplateResult {
    return html<span>F oo Fo o</span>;
  }

  public async loadViewHtml(): Promise<string> {
    const module = await import("./fooFooFeature.view.html?raw");
    return module.default;
  }
}
