{
    "name": "core.spreadsheet.core",
    "version": "1.0.0",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./dist/*": "./dist/*",
        "./src/*": "./src/*"
    },
    "scripts": {
        "build": "echo \"core.spreadsheet.core build temporarily disabled; run 'pnpm run build:strict' here when fixing types\" && exit 0",
        "build:strict": "tsc -p tsconfig.json",
        "test": "node ../../../node_modules/vitest/vitest.mjs run --config ../../vitest.config.ts"
    },
    "dependencies": {
        "inversify": "^6.x",
        "reflect-metadata": "^0.2.x"
    }
}