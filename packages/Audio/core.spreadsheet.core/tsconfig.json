{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // ...existing compilerOptions...
    "composite": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    // keep tests out of strict build
    "types": [
      "node"
    ],
    // override workspace-level cache path with a package-local one
    "tsBuildInfoFile": "./node_modules/.cache/core.spreadsheet.core.tsbuildinfo"
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test"
  ],
  "references": [
    {
      "path": "../core.spreadsheet.abstract"
    }
  ]
}