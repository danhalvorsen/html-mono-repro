{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "isolatedModules": true,

    "types": [
      "vitest/globals",
      "node"
    ],

    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.test.ts",
    "tests/**/*.spec.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}