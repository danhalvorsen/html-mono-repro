{
  "name": "@monorepo/core-graph",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./dist/*": "./dist/*",
    "./src/*": "./src/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm --workspace-root vitest run",
    "clearCache": "pnpm -C .. pnpm --workspace-root vitest --clearCache"
  },
  "dependencies": {
    "inversify": "^6.x",
    "reflect-metadata": "^0.2.x"
  }
}
