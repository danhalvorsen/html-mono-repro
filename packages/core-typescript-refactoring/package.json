{
  "name": "@monorepo/core-typescript-refactoring",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/main.ts",
  "types": "./src/main.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "split:core-filesystem": "tsx ./packages/core-typescript-refactoring/src/main.ts split-declarations ./packages/core-filesystem/src/code.ts ./packages/core-filesystem/src/generated",
    "split:file": "tsx ./packages/core-typescript-refactoring/src/main.ts"
  },
  "dependencies": {
    "@monorepo/core-console-cli": "workspace:*",
    "@monorepo/core-design-patterns-cqrs": "workspace:*",
    "@monorepo/core-filesystem": "workspace:*",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}