{
  "name": "@monorepo/core-graph-pathfinding-a-star",
  "version": "1.0.0",
  "description": "A* pathfinding algorithm over core graph pathfinding abstractions.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:typecheck": "vitest run --typecheck"
  },
  "keywords": [
    "pathfinding",
    "a-star",
    "graph",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "@monorepo/core-graph-pathfinding": "workspace:*",
    "@monorepo/core-graph-pathfinding-domain": "workspace:*",
    "@monorepo/core-graph-pathfinding-domain-validators": "workspace:*",
    "@monorepo/core-graph-pathfinding-composition": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vitest": "^1.6.0"
  },
  "sideEffects": false
}