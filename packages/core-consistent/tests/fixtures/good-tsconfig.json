{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": ["ES2022"],
    "rootDir": "src",
    "outDir": "dist"
  },
  "includes": ["src/**/*"],
  "excludes": ["dist", "node_modules"],
  "rules": ["mustExtendBase"]
}
