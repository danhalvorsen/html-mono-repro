{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Package.json rule definition",
  "description": "Shape of the rule document that describes expectations across workspace package manifests.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "name": {
      "type": "object",
      "properties": {
        "type": {"const": "string"},
        "contains": {"type": "string", "minLength": 0},
        "shouldBe": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      },
      "required": ["type", "shouldBe"],
      "additionalProperties": false
    },
    "scripts": {
      "type": "object",
      "patternProperties": {
        ".+": {
          "type": "object",
          "properties": {
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "startsWith": {"type": "string", "minLength": 1},
                  "equals": {"type": "string", "minLength": 1},
                  "message": {"type": "string", "minLength": 10}
                },
                "required": ["message"],
                "additionalProperties": false
              }
            },
            "required": {"type": "boolean"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "devDependencies": {
      "type": "object",
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": "string", "minLength": 3},
              "required": {"type": "boolean"},
              "shouldExist": {"type": "boolean"},
              "message": {"type": "string", "minLength": 10}
            },
            "required": ["name", "shouldExist", "message"],
            "additionalProperties": false
          }
        },
        "allowedWorkspaceOnly": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "object",
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "prefix": {"type": "string", "pattern": "^@?[^\\s]+"},
              "mustUseWorkspace": {"type": "boolean"},
              "message": {"type": "string", "minLength": 10}
            },
            "required": ["prefix", "mustUseWorkspace", "message"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "references": {
      "type": "object",
      "properties": {
        "shouldExist": {"type": "boolean"},
        "message": {"type": "string"}
      },
      "required": ["shouldExist", "message"],
      "additionalProperties": false
    }
  },
  "required": ["name", "scripts", "devDependencies", "dependencies", "references"],
  "additionalProperties": false
}
