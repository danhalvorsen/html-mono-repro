{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "tsconfig rule definition",
  "description": "Describes the expectations for tsconfig/tsconfig.test files",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "extends": { "type": "string", "minLength": 1 },
    "compilerOptions": {
      "type": "object",
      "properties": {
        "strict": { "type": "boolean" },
        "emitDecoratorMetadata": { "type": "boolean" },
        "experimentalDecorators": { "type": "boolean" },
        "esModuleInterop": { "type": "boolean" },
        "module": { "type": "string" },
        "moduleResolution": { "type": "string" },
        "target": {
          "type": ["string", "array"],
          "minItems": 1
        },
        "lib": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "rootDir": { "type": "string" },
        "outDir": { "type": "string" }
      },
      "required": ["strict","module","moduleResolution","target","rootDir","outDir"],
      "additionalProperties": true
    },
    "includes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "excludes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    }
  },
  "required": ["extends","compilerOptions","includes","excludes"],
  "additionalProperties": false
}
