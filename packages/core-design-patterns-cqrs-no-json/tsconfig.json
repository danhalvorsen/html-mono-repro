{
  "compilerOptions": {
    "target": "ES2021",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "src",
    "outDir": "dist",

    "declaration": true,
    "declarationMap": true,

    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "esModuleInterop": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "lib": ["ES2021"],
    "types": ["node"],

    "experimentalDecorators": false,
    "emitDecoratorMetadata": false
  },
  "include": ["src/**/*"],
  "exclude": [
    "tests",
    "**/*.test.*",
    "**/*.spec.*",
    "vitest.config.ts",
    "vite.config.ts",
    "node_modules",
    "dist"
  ]
}