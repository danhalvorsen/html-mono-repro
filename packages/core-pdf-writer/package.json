{
  "name": "@monorepo/core-pdf-writer",
  "version": "1.0.0",
  "description": "pdf writing utilities for the core PDF processing system.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:typecheck": "vitest run --typecheck"
  },
  "keywords": [
    "module",
    "typescript",
    "pdf",
    "writer"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@monorepo/core-pdf-domain": "workspace:*", 
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.6.205"
  },
  "devDependencies": {
    "@monorepo/core-filesystem": "workspace:*", 
    "@types/node": "^24.10.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  }
}