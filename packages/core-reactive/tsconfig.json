{
  "compilerOptions": {
    "target": "ES2021",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": false,
 
    "outDir": "dist",
    "rootDir": "src",

    "declaration": true,
    "declarationMap": false,
    "sourceMap": true,

    "strict": true,
    "esModuleInterop": true,
    "types": ["node"],

    "resolveJsonModule": true,

    "noEmitOnError": true,
    "skipLibCheck": true
  },
  
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
