{
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "declarationDir": "dist",
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2021", "DOM"],
    "types": [],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "tests",
    "**/*.test.*",
    "**/*.spec.*",
    "vitest.config.ts",
    "vite.config.ts"
  ]
}
