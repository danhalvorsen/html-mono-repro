{
  "extends": "../../tsconfig.node.json",

  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,

    "outDir": "dist",
    "rootDir": "src",

    "lib": ["ES2021", "DOM"],
    "types": ["node"],

    "moduleResolution": "NodeNext",

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },

  "include": ["src/**/*"],

  "exclude": [
    "tests",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.test.js",
    "**/*.spec.js",
    "vitest.config.ts",
    "vite.config.ts"
  ]
}
