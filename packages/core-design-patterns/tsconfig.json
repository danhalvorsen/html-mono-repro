{
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    // ✅ must emit
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "declarationDir": "dist",
    // ✅ output
    "outDir": "dist",
    "rootDir": "src",

    // ✅ library compile surface
    "lib": ["ES2021", "DOM"],
    "types": [],

    // ✅ make module settings consistent (NodeNext requires module=NodeNext)
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    // decorators (keep if you actually need it)
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "tests",
    "**/*.test.*",
    "**/*.spec.*",
    "vitest.config.ts",
    "vite.config.ts"
  ]
}
