{
  "name": "@my-graphics/core-formatter",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "dependencies": {
    "@my-graphics/core-template": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.8.0",
    "vitest": "^3.0.8"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest --config ../../vitest.config.ts",
    "clearCache": "vitest --clearCache"
  },
  "exports": {
  ".": {
    "import": "./dist/index.js",
    "types": "./dist/index.d.ts"
  }
}
}
