{
  "name": "@monorepo/core-ioc-inversify-sample-dispatcher",
  "version": "1.0.0",
  "description": "IoC sample data",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node ./dist/main.js",
    "run:sample": "pnpm build && node ./dist/main.js",
    "test": "vitest run --passWithNoTests",
    "run:ctor-sample": "pnpm build && node ./dist/ctorSample.js",
    "run:all-samples": "pnpm build && node ./dist/runAll.js"
  },
  "dependencies": {
    "inversify": "^6.0.0",
    "reflect-metadata": "^0.2.0",
    "@monorepo/core-ioc-inversify": "workspace:*",
    "@monorepo/core-ioc-inversify-sample-objects": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  }
}
