{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    // 👇 this line is REQUIRED when using moduleResolution: NodeNext
    "module": "NodeNext",
    "noEmitOnError": true,
  },
  "include": ["src", "tests"],
  "exclude": ["dist", "node_modules"]
}
