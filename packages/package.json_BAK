{
  "name": "@monorepo/packages",
  "version": "1.0.0",
  "description": "Frontend libraries and packages for graphics, rendering, and core functionality.",
  "private": true,
  "scripts": {
    "build": "pnpm -r run build",
    "clean": "pnpm -r run C",
    "test": "vitest --config vitest.config.ts",
    "core-ioc-inversify": "pnpm --filter core-ioc-inversify pnpm --workspace-root vitest run",
    "test:config": "pnpm --workspace-root vitest run tests/vitest.config.test.ts",
    "build:ts": "tsc -b",
    "clean:ts": "tsc -b --clean",
    "build:ts:watch": "tsc -b -w",
    "preinstall": "node -e \"console.warn('Prefer running `pnpm install` at repo root; continuing anyway.'); process.exit(0)\""
  },
  "devDependencies": {
    "async": "",
    "@vitest/coverage-v8": "^4.0.14",
    "@vitest/ui": "^4.0.14",
    "chai": "^6.2.1",
    "jsdom": "27.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "file://C:/Users/danha/source/repos/HTML/MonoRepro"
  },
  "keywords": [
    "frontend",
    "graphics",
    "rendering",
    "typescript",
    "webgl",
    "threejs",
    "utilities"
  ],
  "author": "Dan Halvorsen",
  "license": "MIT",
  "dependencies": {
    "reflect-metadata": "^0.2.2",
    "lit": "^3.0.0",
    "three": "^0.160.0"
  }
}
