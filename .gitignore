# ----------------------------
**/dist/
**/dist-ssr/
**/.vite/
**/*.tsbuildinfo

# ----------------------------
# Logs
# ----------------------------
**/logs/
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ----------------------------
# Local env / temp
# ----------------------------
**/*.local
**/*.json.bak
**/*.*.bak
**/tmp/
tmp/
tmpclaude-*
**/tmpclaude-*/

# ----------------------------
# OS / Editor
# ----------------------------
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sw?

# ----------------------------
# Windows reserved device names (prevents weird Git/path issues)
# ----------------------------
**/nul
**/NUL